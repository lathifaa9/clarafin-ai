{"kind":"textbox","id":"sh/e1wn6loz","slide":8,"text":"Filenames are normalized and supported formats are validated.","textPreview":"Filenames are normalized and supported formats are validated.","textChars":61,"textLines":1,"bbox":[96,440,420,42]}
