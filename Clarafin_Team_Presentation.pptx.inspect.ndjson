{"kind":"textbox","id":"sh/a94bq543","slide":8,"text":"Authentication and document ownership keep each workspace scoped to the right user.","textPreview":"Authentication and document ownership keep each workspace scoped to the right user.","textChars":83,"textLines":1,"bbox":[62,76,1090,62]}
